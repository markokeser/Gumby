<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Gumby.Controls"
             x:Class="Gumby.Views.InsertCall"
             Title="Call"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*, Auto">
        <ScrollView>
            <VerticalStackLayout Style="{StaticResource PageContent}">

                <c:PageHeader Icon="📞"
                              Title="Call"
                              Subtitle="Your phone dials this number when the chip is tapped."
                              AccentColor="{StaticResource CatPhone}"
                              BackClicked="OnCancelClicked" />

                <Border Style="{StaticResource Card}" Margin="0,28,0,0">
                    <VerticalStackLayout>
                        <Label Text="PHONE NUMBER" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputShell}">
                            <Entry x:Name="NumberEntry"
                                   Placeholder="+381 60 123 4567"
                                   Keyboard="Telephone" />
                        </Border>

                        <Button x:Name="SelectContactBtn"
                                Text="👤  Choose from contacts"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,14,0,0"
                                Clicked="OnSelectContactClicked" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" Style="{StaticResource ActionBar}">
            <Button x:Name="WriteBtn"
                    Text="Write to NFC chip"
                    Style="{StaticResource PrimaryButton}"
                    Clicked="OnWriteClicked" />
        </Border>
    </Grid>
</ContentPage>
