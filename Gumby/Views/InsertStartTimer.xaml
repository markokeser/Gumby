<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Gumby.Views.InsertStartTimer"
             Title="Start Timer"
             BackgroundColor="#0A0E17"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="0">

            <!-- Header -->
            <VerticalStackLayout Spacing="8" Margin="0,30,0,30" HorizontalOptions="Center">
                <Label Text="⏱️"
                       FontSize="48"
                       HorizontalOptions="Center"/>
                <Label Text="START TIMER"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"/>
                <Label Text="Start a timer when NFC chip is tapped"
                       FontSize="13"
                       TextColor="#A0A8B8"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <!-- Hours Input -->
            <Label Text="Hours"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="White"
                   Margin="0,10,0,5"/>

            <Picker x:Name="HourPicker"
                    Title="Hours"
                    BackgroundColor="#1A2333"
                    TextColor="White"
                    TitleColor="#888888"
                    Margin="0,0,0,15">
                <Picker.Items>
                    <x:String>0</x:String>
                    <x:String>1</x:String>
                    <x:String>2</x:String>
                    <x:String>3</x:String>
                    <x:String>4</x:String>
                    <x:String>5</x:String>
                    <x:String>6</x:String>
                    <x:String>7</x:String>
                    <x:String>8</x:String>
                    <x:String>9</x:String>
                    <x:String>10</x:String>
                    <x:String>11</x:String>
                    <x:String>12</x:String>
                    <x:String>13</x:String>
                    <x:String>14</x:String>
                    <x:String>15</x:String>
                    <x:String>16</x:String>
                    <x:String>17</x:String>
                    <x:String>18</x:String>
                    <x:String>19</x:String>
                    <x:String>20</x:String>
                    <x:String>21</x:String>
                    <x:String>22</x:String>
                    <x:String>23</x:String>
                </Picker.Items>
            </Picker>

            <!-- Minutes Input -->
            <Label Text="Minutes"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="White"
                   Margin="0,10,0,5"/>

            <Picker x:Name="MinutePicker"
                    Title="Minutes"
                    BackgroundColor="#1A2333"
                    TextColor="White"
                    TitleColor="#888888"
                    Margin="0,0,0,15">
                <Picker.Items>
                    <x:String>0</x:String>
                    <x:String>1</x:String>
                    <x:String>2</x:String>
                    <x:String>3</x:String>
                    <x:String>4</x:String>
                    <x:String>5</x:String>
                    <x:String>6</x:String>
                    <x:String>7</x:String>
                    <x:String>8</x:String>
                    <x:String>9</x:String>
                    <x:String>10</x:String>
                    <x:String>11</x:String>
                    <x:String>12</x:String>
                    <x:String>13</x:String>
                    <x:String>14</x:String>
                    <x:String>15</x:String>
                    <x:String>16</x:String>
                    <x:String>17</x:String>
                    <x:String>18</x:String>
                    <x:String>19</x:String>
                    <x:String>20</x:String>
                    <x:String>21</x:String>
                    <x:String>22</x:String>
                    <x:String>23</x:String>
                    <x:String>24</x:String>
                    <x:String>25</x:String>
                    <x:String>26</x:String>
                    <x:String>27</x:String>
                    <x:String>28</x:String>
                    <x:String>29</x:String>
                    <x:String>30</x:String>
                    <x:String>31</x:String>
                    <x:String>32</x:String>
                    <x:String>33</x:String>
                    <x:String>34</x:String>
                    <x:String>35</x:String>
                    <x:String>36</x:String>
                    <x:String>37</x:String>
                    <x:String>38</x:String>
                    <x:String>39</x:String>
                    <x:String>40</x:String>
                    <x:String>41</x:String>
                    <x:String>42</x:String>
                    <x:String>43</x:String>
                    <x:String>44</x:String>
                    <x:String>45</x:String>
                    <x:String>46</x:String>
                    <x:String>47</x:String>
                    <x:String>48</x:String>
                    <x:String>49</x:String>
                    <x:String>50</x:String>
                    <x:String>51</x:String>
                    <x:String>52</x:String>
                    <x:String>53</x:String>
                    <x:String>54</x:String>
                    <x:String>55</x:String>
                    <x:String>56</x:String>
                    <x:String>57</x:String>
                    <x:String>58</x:String>
                    <x:String>59</x:String>
                </Picker.Items>
            </Picker>

            <!-- Seconds Input -->
            <Label Text="Seconds"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="White"
                   Margin="0,10,0,5"/>

            <Picker x:Name="SecondPicker"
                    Title="Seconds"
                    BackgroundColor="#1A2333"
                    TextColor="White"
                    TitleColor="#888888"
                    Margin="0,0,0,15">
                <Picker.Items>
                    <x:String>0</x:String>
                    <x:String>5</x:String>
                    <x:String>10</x:String>
                    <x:String>15</x:String>
                    <x:String>20</x:String>
                    <x:String>25</x:String>
                    <x:String>30</x:String>
                    <x:String>35</x:String>
                    <x:String>40</x:String>
                    <x:String>45</x:String>
                    <x:String>50</x:String>
                    <x:String>55</x:String>
                </Picker.Items>
            </Picker>

            <!-- Total Duration Display -->
            <Label x:Name="DurationLabel"
                   Text="Duration: 0h 0m 0s"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#00BCD4"
                   HorizontalOptions="Center"
                   Margin="0,10,0,20"/>

            <!-- Write Button -->
            <Button x:Name="WriteBtn"
                    Text="💾 Write to NFC Chip"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    CornerRadius="16"
                    HeightRequest="55"
                    FontSize="16"
                    FontAttributes="Bold"
                    Margin="0,10,0,10"
                    Clicked="OnWriteClicked"/>

            <!-- Cancel Button -->
            <Button x:Name="CancelBtn"
                    Text="Cancel"
                    BackgroundColor="#2A3448"
                    TextColor="#A0A8B8"
                    CornerRadius="16"
                    HeightRequest="45"
                    FontSize="14"
                    Clicked="OnCancelClicked"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>