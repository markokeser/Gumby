<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Gumby.Controls"
             x:Class="Gumby.Views.InsertStartTimer"
             Title="Timer"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*, Auto">
        <ScrollView>
            <VerticalStackLayout Style="{StaticResource PageContent}">

                <c:PageHeader Icon="⏱️"
                              Title="Timer"
                              Subtitle="A countdown starts in your clock app when the chip is tapped."
                              AccentColor="{StaticResource CatMulti}"
                              BackClicked="OnCancelClicked" />

                <Border Style="{StaticResource Card}" Margin="0,28,0,0">
                    <VerticalStackLayout>
                        <Label Text="DURATION" Style="{StaticResource FieldLabel}" />

                        <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="8">
                                <Border Style="{StaticResource InputShell}" Padding="4,2">
                                    <Picker x:Name="HourPicker"
                                    Title="0"
                                    FontSize="34"
                                    FontFamily="OpenSansSemibold"
                                    HorizontalTextAlignment="Center"
                                    MinimumHeightRequest="72">
                                <Picker.Items>
                                        <x:String>0</x:String>
                                        <x:String>1</x:String>
                                        <x:String>2</x:String>
                                        <x:String>3</x:String>
                                        <x:String>4</x:String>
                                        <x:String>5</x:String>
                                        <x:String>6</x:String>
                                        <x:String>7</x:String>
                                        <x:String>8</x:String>
                                        <x:String>9</x:String>
                                        <x:String>10</x:String>
                                        <x:String>11</x:String>
                                        <x:String>12</x:String>
                                        <x:String>13</x:String>
                                        <x:String>14</x:String>
                                        <x:String>15</x:String>
                                        <x:String>16</x:String>
                                        <x:String>17</x:String>
                                        <x:String>18</x:String>
                                        <x:String>19</x:String>
                                        <x:String>20</x:String>
                                        <x:String>21</x:String>
                                        <x:String>22</x:String>
                                        <x:String>23</x:String>
                                </Picker.Items>
                            </Picker>
                                </Border>
                                <Label Text="hours" Style="{StaticResource Hint}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="8">
                                <Border Style="{StaticResource InputShell}" Padding="4,2">
                                    <Picker x:Name="MinutePicker"
                                    Title="0"
                                    FontSize="34"
                                    FontFamily="OpenSansSemibold"
                                    HorizontalTextAlignment="Center"
                                    MinimumHeightRequest="72">
                                <Picker.Items>
                                        <x:String>0</x:String>
                                        <x:String>1</x:String>
                                        <x:String>2</x:String>
                                        <x:String>3</x:String>
                                        <x:String>4</x:String>
                                        <x:String>5</x:String>
                                        <x:String>6</x:String>
                                        <x:String>7</x:String>
                                        <x:String>8</x:String>
                                        <x:String>9</x:String>
                                        <x:String>10</x:String>
                                        <x:String>11</x:String>
                                        <x:String>12</x:String>
                                        <x:String>13</x:String>
                                        <x:String>14</x:String>
                                        <x:String>15</x:String>
                                        <x:String>16</x:String>
                                        <x:String>17</x:String>
                                        <x:String>18</x:String>
                                        <x:String>19</x:String>
                                        <x:String>20</x:String>
                                        <x:String>21</x:String>
                                        <x:String>22</x:String>
                                        <x:String>23</x:String>
                                        <x:String>24</x:String>
                                        <x:String>25</x:String>
                                        <x:String>26</x:String>
                                        <x:String>27</x:String>
                                        <x:String>28</x:String>
                                        <x:String>29</x:String>
                                        <x:String>30</x:String>
                                        <x:String>31</x:String>
                                        <x:String>32</x:String>
                                        <x:String>33</x:String>
                                        <x:String>34</x:String>
                                        <x:String>35</x:String>
                                        <x:String>36</x:String>
                                        <x:String>37</x:String>
                                        <x:String>38</x:String>
                                        <x:String>39</x:String>
                                        <x:String>40</x:String>
                                        <x:String>41</x:String>
                                        <x:String>42</x:String>
                                        <x:String>43</x:String>
                                        <x:String>44</x:String>
                                        <x:String>45</x:String>
                                        <x:String>46</x:String>
                                        <x:String>47</x:String>
                                        <x:String>48</x:String>
                                        <x:String>49</x:String>
                                        <x:String>50</x:String>
                                        <x:String>51</x:String>
                                        <x:String>52</x:String>
                                        <x:String>53</x:String>
                                        <x:String>54</x:String>
                                        <x:String>55</x:String>
                                        <x:String>56</x:String>
                                        <x:String>57</x:String>
                                        <x:String>58</x:String>
                                        <x:String>59</x:String>
                                </Picker.Items>
                            </Picker>
                                </Border>
                                <Label Text="minutes" Style="{StaticResource Hint}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="8">
                                <Border Style="{StaticResource InputShell}" Padding="4,2">
                                    <Picker x:Name="SecondPicker"
                                    Title="0"
                                    FontSize="34"
                                    FontFamily="OpenSansSemibold"
                                    HorizontalTextAlignment="Center"
                                    MinimumHeightRequest="72">
                                <Picker.Items>
                                        <x:String>0</x:String>
                                        <x:String>5</x:String>
                                        <x:String>10</x:String>
                                        <x:String>15</x:String>
                                        <x:String>20</x:String>
                                        <x:String>25</x:String>
                                        <x:String>30</x:String>
                                        <x:String>35</x:String>
                                        <x:String>40</x:String>
                                        <x:String>45</x:String>
                                        <x:String>50</x:String>
                                        <x:String>55</x:String>
                                </Picker.Items>
                            </Picker>
                                </Border>
                                <Label Text="seconds" Style="{StaticResource Hint}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Grid>

                        <Border Style="{StaticResource Pill}"
                                BackgroundColor="{StaticResource AccentSoft}"
                                HorizontalOptions="Center"
                                Padding="14,6"
                                Margin="0,20,0,0">
                            <Label x:Name="DurationLabel"
                                   Text="Duration: 0h 0m 0s"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   TextColor="{StaticResource Accent}" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" Style="{StaticResource ActionBar}">
            <Button x:Name="WriteBtn"
                    Text="Write to NFC chip"
                    Style="{StaticResource PrimaryButton}"
                    Clicked="OnWriteClicked" />
        </Border>
    </Grid>
</ContentPage>
