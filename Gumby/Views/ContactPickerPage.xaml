<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Gumby.Controls"
             xmlns:views="clr-namespace:Gumby.Views"
             x:Class="Gumby.Views.ContactPickerPage"
             Title="Choose a contact"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, Auto, *">

        <c:PageHeader Grid.Row="0"
                      Margin="20,8,20,0"
                      Icon="👤"
                      Title="Choose a contact"
                      AccentColor="{StaticResource CatPhone}"
                      BackClicked="OnBackClicked" />

        <Border Grid.Row="1"
                Style="{StaticResource InputShell}"
                Padding="4,0"
                Margin="20,20,20,12">
            <SearchBar x:Name="SearchBar"
                       Placeholder="Search contacts" />
        </Border>

        <CollectionView x:Name="ContactsView"
                        Grid.Row="2"
                        SelectionMode="Single"
                        Margin="20,0,20,0">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="views:ContactInfo">
                    <Border Style="{StaticResource Card}" Padding="12">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="14">
                            <Border WidthRequest="42" HeightRequest="42"
                                    StrokeShape="RoundRectangle 21"
                                    BackgroundColor="{StaticResource AccentSoft}">
                                <Label Text="👤" FontSize="18"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Name}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="15"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Number}"
                                       Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator x:Name="LoadingIndicator"
                           Grid.Row="2"
                           IsRunning="True"
                           IsVisible="True"
                           VerticalOptions="Center"
                           HorizontalOptions="Center" />

        <VerticalStackLayout x:Name="NoContactsLabel"
                             Grid.Row="2"
                             Spacing="6"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             IsVisible="False">
            <Label Text="🔍" FontSize="32" HorizontalOptions="Center" />
            <Label Text="No contacts found" Style="{StaticResource Heading}" HorizontalOptions="Center" />
            <Label Text="Try a different name or number." Style="{StaticResource Caption}" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
