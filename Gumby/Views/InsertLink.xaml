<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Gumby.Controls"
             x:Class="Gumby.Views.InsertLink"
             Title="Website"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*, Auto">
        <ScrollView>
            <VerticalStackLayout Style="{StaticResource PageContent}">

                <c:PageHeader Icon="🌐"
                              Title="Website"
                              Subtitle="The link opens in your browser when the chip is tapped."
                              AccentColor="{StaticResource CatLink}"
                              BackClicked="OnCancelClicked" />

                <Border Style="{StaticResource Card}" Margin="0,28,0,0">
                    <VerticalStackLayout>
                        <Label Text="LINK" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputShell}">
                            <Entry x:Name="LinkEntry"
                                   Placeholder="https://example.com"
                                   Keyboard="Url" />
                        </Border>
                        <Label Text="Tip: copy the address from your browser and paste it here."
                               Style="{StaticResource Hint}"
                               Margin="2,10,0,0" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" Style="{StaticResource ActionBar}">
            <Button x:Name="WriteBtn"
                    Text="Write to NFC chip"
                    Style="{StaticResource PrimaryButton}"
                    Clicked="OnWriteClicked" />
        </Border>
    </Grid>
</ContentPage>
