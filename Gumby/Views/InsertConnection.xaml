<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Gumby.Controls"
             x:Class="Gumby.Views.InsertConnection"
             Title="Connectivity"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContent}">

            <c:PageHeader Icon="📶"
                          Title="Connectivity"
                          Subtitle="Join a WiFi network or control Bluetooth."
                          AccentColor="{StaticResource CatConnect}"
                          BackClicked="OnCancelClicked" />

            <!-- WiFi -->
            <Label Text="WIFI" Style="{StaticResource SectionTitle}" />

            <VerticalStackLayout Spacing="12">
                <c:ActionTile IsRow="True"
                              Icon="📶"
                              Title="Connect to WiFi"
                              Subtitle="Save network name and password to the chip"
                              AccentColor="{StaticResource CatConnect}"
                              Clicked="OnWifiConnectClicked" />

                <c:ActionTile IsRow="True"
                              Icon="⚙️"
                              Title="WiFi settings"
                              Subtitle="Open the system WiFi screen"
                              AccentColor="{StaticResource CatSettings}"
                              Clicked="OnWifiSettingsClicked" />
            </VerticalStackLayout>

            <!-- Bluetooth -->
            <Label Text="BLUETOOTH" Style="{StaticResource SectionTitle}" />

            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10">
                <c:ActionTile Grid.Column="0"
                              Icon="🔵"
                              Title="On"
                              AccentColor="{StaticResource CatConnect}"
                              Clicked="OnBluetoothOnClicked" />

                <c:ActionTile Grid.Column="1"
                              Icon="⚪"
                              Title="Off"
                              AccentColor="{StaticResource CatSettings}"
                              Clicked="OnBluetoothOffClicked" />

                <c:ActionTile Grid.Column="2"
                              Icon="🔁"
                              Title="Toggle"
                              AccentColor="{StaticResource CatMedia}"
                              Clicked="OnBluetoothToggleClicked" />
            </Grid>

            <Label Text="BLUETOOTH SHORTCUTS" Style="{StaticResource SectionTitle}" />

            <VerticalStackLayout Spacing="12">
                <c:ActionTile IsRow="True"
                              Icon="🔗"
                              Title="Pair a new device"
                              Subtitle="Opens Bluetooth on this phone"
                              AccentColor="{StaticResource CatLink}"
                              Clicked="OnBluetoothPairClicked" />

                <c:ActionTile IsRow="True"
                              Icon="⚙️"
                              Title="Bluetooth settings"
                              Subtitle="Open the system Bluetooth screen"
                              AccentColor="{StaticResource CatSettings}"
                              Clicked="OnBluetoothSettingsClicked" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
