<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Gumby.Views.InsertConnection"
             Title="Connection Actions"
             BackgroundColor="#0A0E17"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="0">

            <!-- Header -->
            <VerticalStackLayout Spacing="8" Margin="0,30,0,30" HorizontalOptions="Center">
                <Label Text="🔌"
                       FontSize="48"
                       HorizontalOptions="Center"/>
                <Label Text="CONNECTION ACTIONS"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"/>
                <Label Text="Select an action to write to NFC chip"
                       FontSize="13"
                       TextColor="#A0A8B8"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <!-- WiFi Section -->
            <Label Text="WiFi"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="#4CAF50"
                   Margin="0,10,0,10"/>

            <Grid RowDefinitions="Auto, Auto"
                  ColumnDefinitions="*, *"
                  RowSpacing="12"
                  ColumnSpacing="12">

                <!-- Connect to WiFi -->
                <Button Grid.Row="0" Grid.Column="0"
                        x:Name="WifiConnectBtn"
                        Text="📶 Connect to WiFi"
                        BackgroundColor="#1A2333"
                        TextColor="White"
                        CornerRadius="16"
                        HeightRequest="80"
                        FontSize="14"
                        Clicked="OnWifiConnectClicked"/>

                <!-- WiFi Settings -->
                <Button Grid.Row="0" Grid.Column="1"
                        x:Name="WifiSettingsBtn"
                        Text="⚙️ WiFi Settings"
                        BackgroundColor="#1A2333"
                        TextColor="White"
                        CornerRadius="16"
                        HeightRequest="80"
                        FontSize="14"
                        Clicked="OnWifiSettingsClicked"/>

            </Grid>

            <!-- Bluetooth Section -->
            <Label Text="Bluetooth"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="#2196F3"
                   Margin="0,20,0,10"/>

            <Grid RowDefinitions="Auto, Auto, Auto"
                  ColumnDefinitions="*, *"
                  RowSpacing="12"
                  ColumnSpacing="12">

                <!-- Bluetooth On/Off -->
                <Button Grid.Row="0" Grid.Column="0"
                        x:Name="BluetoothToggleBtn"
                        Text="🩸 Toggle Bluetooth"
                        BackgroundColor="#1A2333"
                        TextColor="White"
                        CornerRadius="16"
                        HeightRequest="70"
                        FontSize="14"
                        Clicked="OnBluetoothToggleClicked"/>

                <!-- Bluetooth On -->
                <Button Grid.Row="0" Grid.Column="1"
                        x:Name="BluetoothOnBtn"
                        Text="🩸 Bluetooth ON"
                        BackgroundColor="#1A2333"
                        TextColor="White"
                        CornerRadius="16"
                        HeightRequest="70"
                        FontSize="14"
                        Clicked="OnBluetoothOnClicked"/>

                <!-- Bluetooth Off -->
                <Button Grid.Row="1" Grid.Column="0"
                        x:Name="BluetoothOffBtn"
                        Text="🩸 Bluetooth OFF"
                        BackgroundColor="#1A2333"
                        TextColor="White"
                        CornerRadius="16"
                        HeightRequest="70"
                        FontSize="14"
                        Clicked="OnBluetoothOffClicked"/>

                <!-- Pair New Device -->
                <Button Grid.Row="1" Grid.Column="1"
                        x:Name="BluetoothPairBtn"
                        Text="🔗 Pair New Device"
                        BackgroundColor="#1A2333"
                        TextColor="White"
                        CornerRadius="16"
                        HeightRequest="70"
                        FontSize="14"
                        Clicked="OnBluetoothPairClicked"/>

                <!-- Bluetooth Settings -->
                <Button Grid.Row="2" Grid.Column="0"
                        x:Name="BluetoothSettingsBtn"
                        Text="⚙️ Bluetooth Settings"
                        BackgroundColor="#1A2333"
                        TextColor="White"
                        CornerRadius="16"
                        HeightRequest="70"
                        FontSize="14"
                        Clicked="OnBluetoothSettingsClicked"/>

            </Grid>

            <!-- Cancel Button -->
            <Button x:Name="CancelBtn"
                    Text="Cancel"
                    BackgroundColor="#2A3448"
                    TextColor="#A0A8B8"
                    CornerRadius="16"
                    HeightRequest="45"
                    FontSize="14"
                    Margin="0,30,0,10"
                    Clicked="OnCancelClicked"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>