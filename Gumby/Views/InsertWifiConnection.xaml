<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Gumby.Views.InsertWifiConnection"
             Title="WiFi Connection"
             BackgroundColor="#0A0E17"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="0">

            <!-- Header -->
            <VerticalStackLayout Spacing="8" Margin="0,30,0,30" HorizontalOptions="Center">
                <Label Text="📶"
                       FontSize="48"
                       HorizontalOptions="Center"/>
                <Label Text="WIFI CONNECTION"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"/>
                <Label Text="Write WiFi credentials to NFC chip"
                       FontSize="13"
                       TextColor="#A0A8B8"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <!-- SSID Input -->
            <Label Text="Network Name (SSID)"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="White"
                   Margin="0,10,0,5"/>

            <Entry x:Name="SsidEntry"
                   Placeholder="Enter WiFi network name"
                   PlaceholderColor="#666666"
                   TextColor="White"
                   BackgroundColor="#1A2333"
                   HeightRequest="50"
                   Margin="0,0,0,15"/>

            <!-- Password Input -->
            <Label Text="Password"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="White"
                   Margin="0,10,0,5"/>

            <Entry x:Name="PasswordEntry"
                   Placeholder="Enter WiFi password"
                   PlaceholderColor="#666666"
                   TextColor="White"
                   BackgroundColor="#1A2333"
                   HeightRequest="50"
                   IsPassword="True"
                   Margin="0,0,0,10"/>

            <!-- Show Password Checkbox -->
            <Grid ColumnDefinitions="Auto, *" Margin="0,0,0,15">
                <CheckBox x:Name="ShowPasswordCheck"
                          Grid.Column="0"
                          Margin="0,0,10,0"
                          HorizontalOptions="Start"/>
                <Label Grid.Column="1"
                       Text="Show password"
                       FontSize="13"
                       TextColor="#A0A8B8"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnShowPasswordTapped"/>
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <!-- Encryption Type -->
            <Label Text="Encryption Type"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="White"
                   Margin="0,10,0,5"/>

            <Picker x:Name="EncryptionPicker"
                    Title="Select encryption"
                    BackgroundColor="#1A2333"
                    TextColor="White"
                    TitleColor="#888888"
                    Margin="0,0,0,20">
                <Picker.Items>
                    <x:String>WPA/WPA2 (Most common)</x:String>
                    <x:String>WEP</x:String>
                    <x:String>WPA3</x:String>
                    <x:String>Open (No password)</x:String>
                </Picker.Items>
            </Picker>

            <!-- Write Button -->
            <Button x:Name="WriteBtn"
                    Text="💾 Write to NFC Chip"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    CornerRadius="16"
                    HeightRequest="55"
                    FontSize="16"
                    FontAttributes="Bold"
                    Margin="0,10,0,10"
                    Clicked="OnWriteClicked"/>

            <!-- Cancel Button -->
            <Button x:Name="CancelBtn"
                    Text="Cancel"
                    BackgroundColor="#2A3448"
                    TextColor="#A0A8B8"
                    CornerRadius="16"
                    HeightRequest="45"
                    FontSize="14"
                    Clicked="OnCancelClicked"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>