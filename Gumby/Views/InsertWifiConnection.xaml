<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Gumby.Controls"
             x:Class="Gumby.Views.InsertWifiConnection"
             Title="WiFi"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*, Auto">
        <ScrollView>
            <VerticalStackLayout Style="{StaticResource PageContent}">

                <c:PageHeader Icon="📶"
                              Title="WiFi network"
                              Subtitle="Guests tap the chip to join your network — no typing passwords."
                              AccentColor="{StaticResource CatConnect}"
                              BackClicked="OnCancelClicked" />

                <Border Style="{StaticResource Card}" Margin="0,28,0,0">
                    <VerticalStackLayout>
                        <Label Text="NETWORK NAME (SSID)" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputShell}">
                            <Entry x:Name="SsidEntry"
                                   Placeholder="My home WiFi" />
                        </Border>

                        <Label Text="SECURITY" Style="{StaticResource FieldLabel}" Margin="2,20,0,8" />
                        <Border Style="{StaticResource InputShell}">
                            <Picker x:Name="EncryptionPicker"
                                    Title="Select security type">
                                <Picker.Items>
                                    <x:String>WPA / WPA2 (most common)</x:String>
                                    <x:String>WEP</x:String>
                                    <x:String>WPA3</x:String>
                                    <x:String>Open (no password)</x:String>
                                </Picker.Items>
                            </Picker>
                        </Border>

                        <Label Text="PASSWORD" Style="{StaticResource FieldLabel}" Margin="2,20,0,8" />
                        <Border Style="{StaticResource InputShell}">
                            <Entry x:Name="PasswordEntry"
                                   Placeholder="Network password"
                                   IsPassword="True"
                                   ClearButtonVisibility="Never" />
                        </Border>

                        <Grid ColumnDefinitions="Auto, *" Margin="-6,6,0,0">
                            <CheckBox x:Name="ShowPasswordCheck" />
                            <Label Grid.Column="1"
                                   Text="Show password"
                                   Style="{StaticResource Caption}"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnShowPasswordTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" Margin="4,16,4,0">
                    <Label Text="🔒" FontSize="14" />
                    <Label Grid.Column="1"
                           Text="The password is stored on the chip. Anyone who can tap the chip can read it."
                           Style="{StaticResource Hint}" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" Style="{StaticResource ActionBar}">
            <Button x:Name="WriteBtn"
                    Text="Write to NFC chip"
                    Style="{StaticResource PrimaryButton}"
                    Clicked="OnWriteClicked" />
        </Border>
    </Grid>
</ContentPage>
