<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Gumby.Controls"
             x:Class="Gumby.Views.InsertYoutubePlaylist"
             Title="YouTube playlist"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*, Auto">
        <ScrollView>
            <VerticalStackLayout Style="{StaticResource PageContent}">

                <c:PageHeader LogoSource="youtube.png"
                              Title="YouTube playlist"
                              Subtitle="The playlist opens in YouTube when the chip is tapped."
                              AccentColor="{StaticResource BrandYouTube}"
                              BackClicked="OnCancelClicked" />

                <Border Style="{StaticResource Card}" Margin="0,28,0,0">
                    <VerticalStackLayout>
                        <Label Text="PLAYLIST LINK OR ID" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputShell}">
                            <Entry x:Name="PlaylistEntry"
                                   Placeholder="https://www.youtube.com/playlist?list=…"
                                   Keyboard="Url" />
                        </Border>
                        <Label Text="In YouTube: Share → Copy link. An ID like PLxZx123456789 also works."
                               Style="{StaticResource Hint}"
                               Margin="2,10,0,0" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" Style="{StaticResource ActionBar}">
            <Button x:Name="WriteBtn"
                    Text="Write to NFC chip"
                    Style="{StaticResource PrimaryButton}"
                    Background="{StaticResource BrandYouTube}"
                    TextColor="White"
                    Clicked="OnWriteClicked" />
        </Border>
    </Grid>
</ContentPage>
