<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Gumby.Views.InsertRingtone"
             Title="Volume Control"
             BackgroundColor="#0A0E17"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="0">

            <!-- Header -->
            <VerticalStackLayout Spacing="8" Margin="0,30,0,20" HorizontalOptions="Center">
                <Label Text="🔊" FontSize="48" HorizontalOptions="Center"/>
                <Label Text="VOLUME CONTROL" 
                       FontSize="22" 
                       FontAttributes="Bold" 
                       TextColor="White" 
                       HorizontalOptions="Center"/>
                <Label Text="Control ringtone and media volume with NFC"
                       FontSize="13" 
                       TextColor="#A0A8B8" 
                       HorizontalOptions="Center" 
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <!-- RINGTONE VOLUME -->
            <Label Text="━━━━━━━ RINGTONE VOLUME ━━━━━━━"
                   FontSize="13"
                   FontAttributes="Bold"
                   TextColor="#FF9800"
                   HorizontalOptions="Center"
                   Margin="0,10,0,15"/>

            <Grid RowDefinitions="Auto, Auto"
                  ColumnDefinitions="*, *"
                  RowSpacing="12"
                  ColumnSpacing="12">
                <Button Grid.Row="0" Grid.Column="0" x:Name="Ringtone0Btn" Text="🔇 0%" BackgroundColor="#1A2333" TextColor="White" CornerRadius="16" HeightRequest="60" FontSize="14" FontAttributes="Bold" Clicked="OnRingtone0Clicked"/>
                <Button Grid.Row="0" Grid.Column="1" x:Name="Ringtone25Btn" Text="🔉 25%" BackgroundColor="#1A2333" TextColor="White" CornerRadius="16" HeightRequest="60" FontSize="14" FontAttributes="Bold" Clicked="OnRingtone25Clicked"/>
                <Button Grid.Row="1" Grid.Column="0" x:Name="Ringtone50Btn" Text="🔉 50%" BackgroundColor="#1A2333" TextColor="White" CornerRadius="16" HeightRequest="60" FontSize="14" FontAttributes="Bold" Clicked="OnRingtone50Clicked"/>
                <Button Grid.Row="1" Grid.Column="1" x:Name="Ringtone75Btn" Text="🔊 75%" BackgroundColor="#1A2333" TextColor="White" CornerRadius="16" HeightRequest="60" FontSize="14" FontAttributes="Bold" Clicked="OnRingtone75Clicked"/>
            </Grid>

            <Button x:Name="Ringtone100Btn" Text="🔊 100%" BackgroundColor="#1A2333" TextColor="White" CornerRadius="16" HeightRequest="60" FontSize="14" FontAttributes="Bold" Margin="0,12,0,5" Clicked="OnRingtone100Clicked"/>

            <!-- MEDIA VOLUME -->
            <Label Text="━━━━━━━ MEDIA VOLUME ━━━━━━━"
                   FontSize="13"
                   FontAttributes="Bold"
                   TextColor="#00BCD4"
                   HorizontalOptions="Center"
                   Margin="0,20,0,15"/>

            <Grid RowDefinitions="Auto, Auto"
                  ColumnDefinitions="*, *"
                  RowSpacing="12"
                  ColumnSpacing="12">
                <Button Grid.Row="0" Grid.Column="0" x:Name="Media0Btn" Text="🔇 0%" BackgroundColor="#1A2333" TextColor="White" CornerRadius="16" HeightRequest="60" FontSize="14" FontAttributes="Bold" Clicked="OnMedia0Clicked"/>
                <Button Grid.Row="0" Grid.Column="1" x:Name="Media25Btn" Text="🔉 25%" BackgroundColor="#1A2333" TextColor="White" CornerRadius="16" HeightRequest="60" FontSize="14" FontAttributes="Bold" Clicked="OnMedia25Clicked"/>
                <Button Grid.Row="1" Grid.Column="0" x:Name="Media50Btn" Text="🔉 50%" BackgroundColor="#1A2333" TextColor="White" CornerRadius="16" HeightRequest="60" FontSize="14" FontAttributes="Bold" Clicked="OnMedia50Clicked"/>
                <Button Grid.Row="1" Grid.Column="1" x:Name="Media75Btn" Text="🔊 75%" BackgroundColor="#1A2333" TextColor="White" CornerRadius="16" HeightRequest="60" FontSize="14" FontAttributes="Bold" Clicked="OnMedia75Clicked"/>
            </Grid>

            <Button x:Name="Media100Btn" Text="🔊 100%" BackgroundColor="#1A2333" TextColor="White" CornerRadius="16" HeightRequest="60" FontSize="14" FontAttributes="Bold" Margin="0,12,0,5" Clicked="OnMedia100Clicked"/>

            <!-- SOUND CONTROLS -->
            <Label Text="━━━━━━━ SOUND CONTROLS ━━━━━━━"
                   FontSize="13"
                   FontAttributes="Bold"
                   TextColor="#4CAF50"
                   HorizontalOptions="Center"
                   Margin="0,20,0,15"/>

            <Grid RowDefinitions="Auto"
                  ColumnDefinitions="*, *, *"
                  RowSpacing="12"
                  ColumnSpacing="12">
                <Button Grid.Row="0" Grid.Column="0" x:Name="MuteBtn" Text="🔇 Mute" BackgroundColor="#1A2333" TextColor="White" CornerRadius="16" HeightRequest="60" FontSize="14" FontAttributes="Bold" Clicked="OnMuteClicked"/>
                <Button Grid.Row="0" Grid.Column="1" x:Name="UnmuteBtn" Text="🔊 Unmute" BackgroundColor="#1A2333" TextColor="White" CornerRadius="16" HeightRequest="60" FontSize="14" FontAttributes="Bold" Clicked="OnUnmuteClicked"/>
                <Button Grid.Row="0" Grid.Column="2" x:Name="VibrateBtn" Text="📳 Vibrate" BackgroundColor="#1A2333" TextColor="White" CornerRadius="16" HeightRequest="60" FontSize="14" FontAttributes="Bold" Clicked="OnVibrateClicked"/>
            </Grid>

            <!-- Cancel Button -->
            <Button x:Name="CancelBtn" Text="Cancel" BackgroundColor="#2A3448" TextColor="#A0A8B8" CornerRadius="16" HeightRequest="45" FontSize="14" Margin="0,30,0,10" Clicked="OnCancelClicked"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>