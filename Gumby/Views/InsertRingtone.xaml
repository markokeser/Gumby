<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Gumby.Controls"
             x:Class="Gumby.Views.InsertRingtone"
             Title="Sound"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContent}">

            <c:PageHeader Icon="🔊"
                          Title="Sound"
                          Subtitle="Change the volume or sound mode when the chip is tapped."
                          AccentColor="{StaticResource CatSound}"
                          BackClicked="OnCancelClicked" />

            <!-- Režim zvuka -->
            <Label Text="SOUND MODE" Style="{StaticResource SectionTitle}" />

            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10">
                <c:ActionTile Grid.Column="0"
                              Icon="🔇"
                              Title="Mute"
                              AccentColor="{StaticResource Danger}"
                              Clicked="OnMuteClicked" />
                <c:ActionTile Grid.Column="1"
                              Icon="🔔"
                              Title="Sound on"
                              AccentColor="{StaticResource CatPhone}"
                              Clicked="OnUnmuteClicked" />
                <c:ActionTile Grid.Column="2"
                              Icon="📳"
                              Title="Vibrate"
                              AccentColor="{StaticResource CatMedia}"
                              Clicked="OnVibrateClicked" />
            </Grid>

            <!-- Jačina zvona -->
            <Label Text="RINGTONE VOLUME" Style="{StaticResource SectionTitle}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                        <Label Text="📞" FontSize="20" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Ringtone" Style="{StaticResource Heading}" />
                            <Label Text="Calls and notifications" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="*, *, *, *, *" ColumnSpacing="8">
                        <Button Grid.Column="0" x:Name="Ringtone0Btn" Text="0%" Style="{StaticResource ChipButton}" Clicked="OnRingtone0Clicked" />
                        <Button Grid.Column="1" x:Name="Ringtone25Btn" Text="25%" Style="{StaticResource ChipButton}" Clicked="OnRingtone25Clicked" />
                        <Button Grid.Column="2" x:Name="Ringtone50Btn" Text="50%" Style="{StaticResource ChipButton}" Clicked="OnRingtone50Clicked" />
                        <Button Grid.Column="3" x:Name="Ringtone75Btn" Text="75%" Style="{StaticResource ChipButton}" Clicked="OnRingtone75Clicked" />
                        <Button Grid.Column="4" x:Name="Ringtone100Btn" Text="Max" Style="{StaticResource ChipButton}" Clicked="OnRingtone100Clicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Jačina medija -->
            <Label Text="MEDIA VOLUME" Style="{StaticResource SectionTitle}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                        <Label Text="🎵" FontSize="20" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Media" Style="{StaticResource Heading}" />
                            <Label Text="Music, videos and games" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="*, *, *, *, *" ColumnSpacing="8">
                        <Button Grid.Column="0" x:Name="Media0Btn" Text="0%" Style="{StaticResource ChipButton}" Clicked="OnMedia0Clicked" />
                        <Button Grid.Column="1" x:Name="Media25Btn" Text="25%" Style="{StaticResource ChipButton}" Clicked="OnMedia25Clicked" />
                        <Button Grid.Column="2" x:Name="Media50Btn" Text="50%" Style="{StaticResource ChipButton}" Clicked="OnMedia50Clicked" />
                        <Button Grid.Column="3" x:Name="Media75Btn" Text="75%" Style="{StaticResource ChipButton}" Clicked="OnMedia75Clicked" />
                        <Button Grid.Column="4" x:Name="Media100Btn" Text="Max" Style="{StaticResource ChipButton}" Clicked="OnMedia100Clicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="Choosing an option takes you straight to writing the chip."
                   Style="{StaticResource Hint}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,20,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
