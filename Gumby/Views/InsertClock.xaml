<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Gumby.Controls"
             x:Class="Gumby.Views.InsertClock"
             Title="Clock"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContent}">

            <c:PageHeader Icon="⏰"
                          Title="Clock"
                          Subtitle="Set an alarm or start a countdown with a single tap."
                          AccentColor="{StaticResource CatClock}"
                          BackClicked="OnCancelClicked" />

            <Grid ColumnDefinitions="*, *"
                  ColumnSpacing="12"
                  Margin="0,28,0,0">

                <c:ActionTile Grid.Column="0"
                              Icon="⏰"
                              Title="Alarm"
                              Subtitle="Wake up at a set time"
                              AccentColor="{StaticResource CatClock}"
                              Clicked="OnAlarmClicked" />

                <c:ActionTile Grid.Column="1"
                              Icon="⏱️"
                              Title="Timer"
                              Subtitle="Start a countdown"
                              AccentColor="{StaticResource CatMulti}"
                              Clicked="OnTimerClicked" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
