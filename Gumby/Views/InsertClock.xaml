<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Gumby.Views.InsertClock"
             Title="Clock Actions"
             BackgroundColor="#0A0E17"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="0">

            <!-- Header -->
            <VerticalStackLayout Spacing="8" Margin="0,30,0,40" HorizontalOptions="Center">
                <Label Text="⏰"
                       FontSize="48"
                       HorizontalOptions="Center"/>
                <Label Text="CLOCK ACTIONS"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"/>
                <Label Text="Select an action to write to NFC chip"
                       FontSize="13"
                       TextColor="#A0A8B8"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <!-- Action Buttons -->
            <Grid RowDefinitions="Auto, Auto"
                  ColumnDefinitions="*, *"
                  RowSpacing="15"
                  ColumnSpacing="15">

                <!-- Set Alarm -->
                <Button Grid.Row="0" Grid.Column="0"
                        x:Name="AlarmBtn"
                        Text="⏰ Set Alarm"
                        BackgroundColor="#1A2333"
                        TextColor="White"
                        CornerRadius="16"
                        HeightRequest="100"
                        FontSize="16"
                        Clicked="OnAlarmClicked"/>


                <!-- Timer -->
                <Button Grid.Row="0" Grid.Column="1"
                        x:Name="TimerBtn"
                        Text="⏲️ Timer"
                        BackgroundColor="#1A2333"
                        TextColor="White"
                        CornerRadius="16"
                        HeightRequest="100"
                        FontSize="16"
                        Clicked="OnTimerClicked"/>

            </Grid>

            <!-- Cancel Button -->
            <Button x:Name="CancelBtn"
                    Text="Cancel"
                    BackgroundColor="#2A3448"
                    TextColor="#A0A8B8"
                    CornerRadius="16"
                    HeightRequest="45"
                    FontSize="14"
                    Margin="0,40,0,10"
                    Clicked="OnCancelClicked"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>