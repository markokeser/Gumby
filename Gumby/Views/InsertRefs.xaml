<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Gumby.Controls"
             x:Class="Gumby.Views.InsertRefs"
             Title="Links &amp; apps"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContent}">

            <c:PageHeader Icon="🔗"
                          Title="Links &amp; apps"
                          Subtitle="Open a website, an app or a place when the chip is tapped."
                          AccentColor="{StaticResource CatLink}"
                          BackClicked="OnCancelClicked" />

            <Grid ColumnDefinitions="*, *"
                  RowDefinitions="Auto, Auto"
                  ColumnSpacing="12"
                  RowSpacing="12"
                  Margin="0,28,0,0">

                <c:ActionTile Grid.Row="0" Grid.Column="0"
                              Icon="🌐"
                              Title="Website"
                              Subtitle="Open any link"
                              AccentColor="{StaticResource CatLink}"
                              Clicked="OnLinkClicked" />

                <c:ActionTile Grid.Row="0" Grid.Column="1"
                              Icon="📱"
                              Title="Open app"
                              Subtitle="Launch an installed app"
                              AccentColor="{StaticResource CatConnect}"
                              Clicked="OnOpenAppClicked" />

                <c:ActionTile Grid.Row="1" Grid.Column="0"
                              Icon="📸"
                              Title="Instagram"
                              Subtitle="Open a reel"
                              AccentColor="{StaticResource BrandInstagram}"
                              Clicked="OnInstagramClicked" />

                <c:ActionTile Grid.Row="1" Grid.Column="1"
                              Icon="🗺️"
                              Title="Maps"
                              Subtitle="Navigate to a place"
                              AccentColor="{StaticResource BrandMaps}"
                              Clicked="OnGoogleMapsClicked" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
