<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Gumby.Views.InsertRefs"
             Title="Refs"
             BackgroundColor="#0A0E17"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="0">

            <!-- Header -->
            <VerticalStackLayout Spacing="8" Margin="0,30,0,30" HorizontalOptions="Center">
                <Label Text="🔗"
                       FontSize="48"
                       HorizontalOptions="Center"/>
                <Label Text="Refs"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"/>
                <Label Text="Write a link or select an app to open"
                       FontSize="13"
                       TextColor="#A0A8B8"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <!-- Dugmad za izbor -->
            <Grid RowDefinitions="Auto, Auto"
                  ColumnDefinitions="*, *"
                  RowSpacing="15"
                  ColumnSpacing="15">

                <!-- Link Button -->
                <Button Grid.Row="0" Grid.Column="0"
                        x:Name="LinkBtn"
                        Text="🔗 Open Link"
                        BackgroundColor="#1A2333"
                        TextColor="White"
                        CornerRadius="16"
                        HeightRequest="100"
                        FontSize="16"
                        Clicked="OnLinkClicked"/>

                <!-- Open App Button -->
                <Button Grid.Row="0" Grid.Column="1"
                        x:Name="OpenAppBtn"
                        Text="📱 Open App"
                        BackgroundColor="#1A2333"
                        TextColor="White"
                        CornerRadius="16"
                        HeightRequest="100"
                        FontSize="16"
                        Clicked="OnOpenAppClicked"/>

                <!-- Instagram Button -->
                <Button Grid.Row="1" Grid.Column="0"
                        x:Name="InstagramBtn"
                        Text="📸 Instagram"
                        BackgroundColor="#1A2333"
                        TextColor="White"
                        CornerRadius="16"
                        HeightRequest="100"
                        FontSize="16"
                        Clicked="OnInstagramClicked"/>

                <!-- Google Maps Button -->
                <Button Grid.Row="1" Grid.Column="1"
                        x:Name="GoogleMapsBtn"
                        Text="🗺️ Maps"
                        BackgroundColor="#1A2333"
                        TextColor="White"
                        CornerRadius="16"
                        HeightRequest="100"
                        FontSize="16"
                        Clicked="OnGoogleMapsClicked"/>

            </Grid>

            <!-- Cancel Button -->
            <Button x:Name="CancelBtn"
                    Text="Cancel"
                    BackgroundColor="#2A3448"
                    TextColor="#A0A8B8"
                    CornerRadius="16"
                    HeightRequest="45"
                    FontSize="14"
                    Margin="0,30,0,10"
                    Clicked="OnCancelClicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>