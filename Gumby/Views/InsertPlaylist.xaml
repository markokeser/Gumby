<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Gumby.Controls"
             x:Class="Gumby.Views.InsertPlaylist"
             Title="Media"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContent}">

            <c:PageHeader Icon="🎵"
                          Title="Media"
                          Subtitle="Start your favourite playlist the moment you tap the chip."
                          AccentColor="{StaticResource CatMedia}"
                          BackClicked="OnCancelClicked" />

            <VerticalStackLayout Spacing="12" Margin="0,28,0,0">

                <c:ActionTile IsRow="True"
                              Icon="▶️"
                              Title="YouTube"
                              Subtitle="Open a playlist in YouTube"
                              AccentColor="{StaticResource BrandYouTube}"
                              Clicked="OnYoutubeClicked" />

                <c:ActionTile IsRow="True"
                              Icon="🎧"
                              Title="Spotify"
                              Subtitle="Open a playlist in Spotify"
                              AccentColor="{StaticResource BrandSpotify}"
                              Clicked="OnSpotifyClicked" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
