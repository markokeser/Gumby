<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Gumby.Views.InsertPhone"
             Title="Phone Actions"
             BackgroundColor="#0A0E17"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="0">

            <!-- Header -->
            <VerticalStackLayout Spacing="8" Margin="0,30,0,30" HorizontalOptions="Center">
                <Label Text="📱"
                       FontSize="48"
                       HorizontalOptions="Center"/>
                <Label Text="PHONE ACTIONS"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"/>
                <Label Text="Select an action to write to NFC chip"
                       FontSize="13"
                       TextColor="#A0A8B8"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <!-- Action Buttons -->
            <Grid RowDefinitions="Auto, Auto, Auto"
                  ColumnDefinitions="*, *"
                  RowSpacing="15"
                  ColumnSpacing="15">

                <!-- Call -->
                <Button Grid.Row="0" Grid.Column="0"
                        x:Name="CallBtn"
                        Text="📞 Call"
                        BackgroundColor="#1A2333"
                        TextColor="White"
                        CornerRadius="16"
                        HeightRequest="90"
                        FontSize="16"
                        Clicked="OnCallClicked"/>

                <!-- SMS -->
                <Button Grid.Row="0" Grid.Column="1"
                        x:Name="SmsBtn"
                        Text="💬 SMS"
                        BackgroundColor="#1A2333"
                        TextColor="White"
                        CornerRadius="16"
                        HeightRequest="90"
                        FontSize="16"
                        Clicked="OnSmsClicked"/>

                <!-- Add Contact -->
                <Button Grid.Row="1" Grid.Column="0"
                        x:Name="AddContactBtn"
                        Text="👤 Add Contact"
                        BackgroundColor="#1A2333"
                        TextColor="White"
                        CornerRadius="16"
                        HeightRequest="90"
                        FontSize="14"
                        Clicked="OnAddContactClicked"/>

            </Grid>

            <!-- Cancel Button -->
            <Button x:Name="CancelBtn"
                    Text="Cancel"
                    BackgroundColor="#2A3448"
                    TextColor="#A0A8B8"
                    CornerRadius="16"
                    HeightRequest="45"
                    FontSize="14"
                    Margin="0,30,0,10"
                    Clicked="OnCancelClicked"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>