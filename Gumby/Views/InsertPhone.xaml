<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Gumby.Controls"
             x:Class="Gumby.Views.InsertPhone"
             Title="Phone"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContent}">

            <c:PageHeader Icon="📞"
                          Title="Phone"
                          Subtitle="Call someone, send a message or share a contact card."
                          AccentColor="{StaticResource CatPhone}"
                          BackClicked="OnCancelClicked" />

            <VerticalStackLayout Spacing="12" Margin="0,28,0,0">

                <c:ActionTile IsRow="True"
                              Icon="📞"
                              Title="Call"
                              Subtitle="Dial a number instantly"
                              AccentColor="{StaticResource CatPhone}"
                              Clicked="OnCallClicked" />

                <c:ActionTile IsRow="True"
                              Icon="💬"
                              Title="Text message"
                              Subtitle="Send an SMS with your own text"
                              AccentColor="{StaticResource CatConnect}"
                              Clicked="OnSmsClicked" />

                <c:ActionTile IsRow="True"
                              Icon="👤"
                              Title="Contact card"
                              Subtitle="Let others save your details"
                              AccentColor="{StaticResource CatMedia}"
                              Clicked="OnAddContactClicked" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
