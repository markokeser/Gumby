<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Gumby.Controls"
             x:Class="Gumby.Views.InsertInstagram"
             Title="Instagram reel"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*, Auto">
        <ScrollView>
            <VerticalStackLayout Style="{StaticResource PageContent}">

                <c:PageHeader LogoSource="instagram.png"
                              Title="Instagram reel"
                              Subtitle="The reel opens in Instagram when the chip is tapped."
                              AccentColor="{StaticResource BrandInstagram}"
                              BackClicked="OnCancelClicked" />

                <Border Style="{StaticResource Card}" Margin="0,28,0,0">
                    <VerticalStackLayout>
                        <Label Text="REEL LINK" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputShell}">
                            <Entry x:Name="ReelEntry"
                                   Placeholder="https://www.instagram.com/reel/…"
                                   Keyboard="Url" />
                        </Border>
                        <Label Text="In Instagram: Share → Copy link."
                               Style="{StaticResource Hint}"
                               Margin="2,10,0,0" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" Style="{StaticResource ActionBar}">
            <Button x:Name="WriteBtn"
                    Text="Write to NFC chip"
                    Style="{StaticResource PrimaryButton}"
                    TextColor="White"
                    Clicked="OnWriteClicked">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F58529" Offset="0.0" />
                        <GradientStop Color="#DD2A7B" Offset="0.5" />
                        <GradientStop Color="#8134AF" Offset="1.0" />
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
        </Border>
    </Grid>
</ContentPage>
