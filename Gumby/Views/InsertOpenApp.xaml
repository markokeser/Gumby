<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Gumby.Controls"
             x:Class="Gumby.Views.InsertOpenApp"
             Title="Open app"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*, Auto">
        <ScrollView>
            <VerticalStackLayout Style="{StaticResource PageContent}">

                <c:PageHeader Icon="📱"
                              Title="Open app"
                              Subtitle="Launch any installed app when the chip is tapped."
                              AccentColor="{StaticResource CatConnect}"
                              BackClicked="OnCancelClicked" />

                <Label Text="APP" Style="{StaticResource SectionTitle}" />

                <c:ActionTile x:Name="SelectAppBtn"
                              IsRow="True"
                              Icon="📋"
                              Title="Choose an app"
                              Subtitle="Pick from the apps on this phone"
                              AccentColor="{StaticResource CatConnect}"
                              Clicked="OnSelectAppClicked" />

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                        <Label Text="✓"
                               FontSize="18"
                               TextColor="{StaticResource TextMuted}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               x:Name="SelectedAppLabel"
                               Text="No app selected yet"
                               Style="{StaticResource Caption}"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" Style="{StaticResource ActionBar}">
            <Button x:Name="WriteBtn"
                    Text="Write to NFC chip"
                    Style="{StaticResource PrimaryButton}"
                    IsEnabled="False"
                    Clicked="OnWriteClicked" />
        </Border>
    </Grid>
</ContentPage>
