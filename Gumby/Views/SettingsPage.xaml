<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Gumby.Controls"
             x:Class="Gumby.Views.SettingsPage"
             Title="Settings"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContent}">

            <c:PageHeader Icon="⚙️"
                          Title="Settings"
                          Subtitle="Make Gumby work the way you like."
                          AccentColor="{StaticResource CatSettings}"
                          BackClicked="OnBackClicked" />

            <!-- Pregledač -->
            <Label Text="BROWSER" Style="{StaticResource SectionTitle}" />

            <Border Style="{StaticResource Card}" Padding="16">
                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14">
                        <Border WidthRequest="40" HeightRequest="40"
                                StrokeShape="RoundRectangle 13"
                                BackgroundColor="{StaticResource AccentSoft}">
                            <Label Text="🌐" FontSize="18"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Custom browser" Style="{StaticResource Heading}" FontSize="16" />
                            <Label Text="Open links in a browser you choose"
                                   Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="2"
                                x:Name="BrowserSwitch"
                                VerticalOptions="Center"
                                Toggled="OnBrowserToggled" />
                    </Grid>

                    <!-- Izbor pregledača (vidljiv kada je prekidač uključen) -->
                    <Border x:Name="BrowserSelectionFrame"
                            BackgroundColor="{StaticResource SurfaceRaised}"
                            StrokeShape="RoundRectangle 14"
                            Padding="14,10,10,10"
                            Margin="0,16,0,0"
                            IsVisible="False">
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label x:Name="SelectedBrowserLabel"
                                       Text="Default browser"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="15" />
                                <Label x:Name="SelectedBrowserPackageLabel"
                                       Text=""
                                       Style="{StaticResource Hint}"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    x:Name="SelectBrowserBtn"
                                    Text="Change"
                                    Style="{StaticResource ChipButton}"
                                    HeightRequest="40"
                                    Padding="16,0"
                                    Clicked="OnSelectBrowserClicked" />
                        </Grid>
                    </Border>

                    <Label x:Name="BrowserInfoLabel"
                           Text="Links will open in your chosen browser"
                           Style="{StaticResource Hint}"
                           Margin="2,14,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Uskoro -->
            <Label Text="PREFERENCES" Style="{StaticResource SectionTitle}" />

            <Border Style="{StaticResource Card}" Padding="16,6">
                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10" MinimumHeightRequest="56">
                        <Label Text="Dark theme" VerticalOptions="Center" />
                        <Border Grid.Column="1" Style="{StaticResource Pill}">
                            <Label Text="SOON" Style="{StaticResource Overline}" FontSize="10" />
                        </Border>
                        <Switch Grid.Column="2" x:Name="ThemeSwitch" IsToggled="True" IsEnabled="False"
                                VerticalOptions="Center" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" />
                    <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10" MinimumHeightRequest="56">
                        <Label Text="NFC sound" VerticalOptions="Center" />
                        <Border Grid.Column="1" Style="{StaticResource Pill}">
                            <Label Text="SOON" Style="{StaticResource Overline}" FontSize="10" />
                        </Border>
                        <Switch Grid.Column="2" x:Name="SoundSwitch" IsEnabled="False"
                                VerticalOptions="Center" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" />
                    <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10" MinimumHeightRequest="56">
                        <Label Text="NFC vibration" VerticalOptions="Center" />
                        <Border Grid.Column="1" Style="{StaticResource Pill}">
                            <Label Text="SOON" Style="{StaticResource Overline}" FontSize="10" />
                        </Border>
                        <Switch Grid.Column="2" x:Name="VibrationSwitch" IsEnabled="False"
                                VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- O aplikaciji -->
            <Label Text="ABOUT" Style="{StaticResource SectionTitle}" />

            <Border Style="{StaticResource Card}">
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="14">
                    <Border WidthRequest="44" HeightRequest="44"
                            StrokeShape="RoundRectangle 14"
                            Background="{StaticResource AccentGradient}">
                        <Label Text="G"
                               FontFamily="OpenSansSemibold"
                               FontSize="22"
                               TextColor="{StaticResource TextOnAccent}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="Gumby NFC Commander" Style="{StaticResource Heading}" FontSize="16" />
                        <Label Text="Version 1.0" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
