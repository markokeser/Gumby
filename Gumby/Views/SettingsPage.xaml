<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Gumby.Views.SettingsPage"
             Title="Settings"
             BackgroundColor="#0A0E17"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="0">

            <!-- Header -->
            <VerticalStackLayout Spacing="8" Margin="0,30,0,30" HorizontalOptions="Center">
                <Label Text="⚙️"
                       FontSize="48"
                       HorizontalOptions="Center"/>
                <Label Text="SETTINGS"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"/>
                <Label Text="Customize your NFC experience"
                       FontSize="13"
                       TextColor="#A0A8B8"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <!-- ========== BROWSER SECTION ========== -->
            <Label Text="━━━━━━━ BROWSER ━━━━━━━"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#4CAF50"
                   HorizontalOptions="Center"
                   Margin="0,10,0,15"/>

            <!-- Custom Browser Toggle -->
            <Grid ColumnDefinitions="*, Auto" Margin="0,5,0,10">
                <Label Text="Use custom browser" 
                       FontSize="15"
                       TextColor="White" 
                       VerticalOptions="Center"/>
                <Switch x:Name="BrowserSwitch" 
                        Toggled="OnBrowserToggled"/>
            </Grid>

            <!-- Browser Selection Row -->
            <Frame x:Name="BrowserSelectionFrame"
                   BackgroundColor="#1A2333"
                   CornerRadius="12"
                   Padding="12"
                   Margin="0,5,0,15"
                   IsVisible="False">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0" 
                           Text="🌐" 
                           FontSize="18"
                           VerticalOptions="Center"
                           Margin="0,0,12,0"/>

                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                        <Label x:Name="SelectedBrowserLabel"
                               Text="Default browser"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="White"/>
                        <Label x:Name="SelectedBrowserPackageLabel"
                               Text=""
                               FontSize="11"
                               TextColor="#888888"/>
                    </VerticalStackLayout>

                    <Button Grid.Column="2"
                            x:Name="SelectBrowserBtn"
                            Text="Change"
                            BackgroundColor="#2A3448"
                            TextColor="#A0A8B8"
                            CornerRadius="8"
                            HeightRequest="35"
                            WidthRequest="70"
                            FontSize="13"
                            Clicked="OnSelectBrowserClicked"/>
                </Grid>
            </Frame>

            <!-- Info text -->
            <Label x:Name="BrowserInfoLabel"
                   Text="Links will open in your chosen browser"
                   FontSize="12"
                   TextColor="#666666"
                   HorizontalOptions="Center"
                   IsVisible="True"/>

            <!-- ========== THEME SECTION (za kasnije) ========== -->
            <Label Text="━━━━━━━ THEME ━━━━━━━"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#4CAF50"
                   HorizontalOptions="Center"
                   Margin="0,30,0,15"/>

            <Grid ColumnDefinitions="*, Auto" Margin="0,5,0,15">
                <Label Text="Dark theme" 
                       FontSize="15"
                       TextColor="White" 
                       VerticalOptions="Center"/>
                <Switch x:Name="ThemeSwitch" 
                        IsEnabled="False"/>
            </Grid>

            <!-- ========== NOTIFICATIONS SECTION (za kasnije) ========== -->
            <Label Text="━━━━━━━ NOTIFICATIONS ━━━━━━━"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#4CAF50"
                   HorizontalOptions="Center"
                   Margin="0,30,0,15"/>

            <Grid ColumnDefinitions="*, Auto" Margin="0,5,0,5">
                <Label Text="NFC sound" 
                       FontSize="15"
                       TextColor="White" 
                       VerticalOptions="Center"/>
                <Switch x:Name="SoundSwitch" 
                        IsEnabled="False"/>
            </Grid>

            <Grid ColumnDefinitions="*, Auto" Margin="0,5,0,15">
                <Label Text="NFC vibration" 
                       FontSize="15"
                       TextColor="White" 
                       VerticalOptions="Center"/>
                <Switch x:Name="VibrationSwitch" 
                        IsEnabled="False"/>
            </Grid>

            <!-- Footer -->
            <BoxView HeightRequest="1" BackgroundColor="#2A3448" Margin="0,20,0,10"/>
            <Label Text="Gumby NFC Commander v1.0"
                   FontSize="11"
                   TextColor="#555555"
                   HorizontalOptions="Center"
                   Margin="0,0,0,20"/>

            <!-- Back Button -->
            <Button x:Name="BackBtn"
                    Text="Back"
                    BackgroundColor="#2A3448"
                    TextColor="#A0A8B8"
                    CornerRadius="16"
                    HeightRequest="45"
                    FontSize="14"
                    Margin="0,10,0,10"
                    Clicked="OnBackClicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>