<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Gumby.Controls"
             x:Class="Gumby.Views.InsertMessage"
             Title="Text message"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*, Auto">
        <ScrollView>
            <VerticalStackLayout Style="{StaticResource PageContent}">

                <c:PageHeader Icon="💬"
                              Title="Text message"
                              Subtitle="Send an SMS automatically when the chip is tapped."
                              AccentColor="{StaticResource CatConnect}"
                              BackClicked="OnCancelClicked" />

                <Border Style="{StaticResource Card}" Margin="0,28,0,0">
                    <VerticalStackLayout>
                        <Label Text="RECIPIENT" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputShell}">
                            <Entry x:Name="PhoneEntry"
                                   Placeholder="+381 60 123 4567"
                                   Keyboard="Telephone" />
                        </Border>

                        <Button x:Name="SelectContactBtn"
                                Text="👤  Choose from contacts"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,14,0,0"
                                Clicked="OnSelectContactClicked" />

                        <BoxView Style="{StaticResource Divider}" Margin="0,20" />

                        <Label Text="MESSAGE · OPTIONAL" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputShell}" Padding="14,6">
                            <Editor x:Name="MessageEntry"
                                    Placeholder="On my way!"
                                    AutoSize="TextChanges"
                                    MinimumHeightRequest="96" />
                        </Border>
                        <Label Text="Leave empty to send a default message."
                               Style="{StaticResource Hint}"
                               Margin="2,10,0,0" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" Style="{StaticResource ActionBar}">
            <Button x:Name="WriteBtn"
                    Text="Write to NFC chip"
                    Style="{StaticResource PrimaryButton}"
                    Clicked="OnWriteClicked" />
        </Border>
    </Grid>
</ContentPage>
