<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Gumby.Controls"
             xmlns:views="clr-namespace:Gumby.Views"
             x:Class="Gumby.Views.MultiCommandBuilder"
             Title="Routine"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, Auto, *, Auto">

        <!-- Zaglavlje -->
        <c:PageHeader Grid.Row="0"
                      Margin="20,8,20,0"
                      Icon="🧩"
                      Title="Routine"
                      Subtitle="Add steps — they all run, in order, when the chip is tapped."
                      AccentColor="{StaticResource CatMulti}"
                      BackClicked="OnCancelClicked" />

        <!-- Naslov liste -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*, Auto"
              Margin="24,24,12,8">
            <Label Text="STEPS"
                   Style="{StaticResource Overline}"
                   VerticalOptions="Center" />
            <Button Grid.Column="1"
                    x:Name="ClearBtn"
                    Text="Clear all"
                    Style="{StaticResource DangerGhostButton}"
                    Clicked="OnClearClicked" />
        </Grid>

        <!-- Lista koraka -->
        <CollectionView Grid.Row="2"
                        x:Name="CommandsView"
                        Margin="20,0">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <Border Style="{StaticResource Card}"
                        StrokeDashArray="4,4"
                        BackgroundColor="Transparent"
                        Padding="24"
                        VerticalOptions="Start">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="🧩" FontSize="32" HorizontalOptions="Center" />
                        <Label Text="No steps yet"
                               Style="{StaticResource Heading}"
                               HorizontalOptions="Center"
                               Margin="0,6,0,0" />
                        <Label Text="Tap “Add step” to build your routine — for example turn on WiFi, then open Spotify."
                               Style="{StaticResource Caption}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="views:CommandItem">
                    <Border Style="{StaticResource Card}" Padding="14,10,8,10">
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                            <Border WidthRequest="10" HeightRequest="10"
                                    StrokeShape="RoundRectangle 5"
                                    BackgroundColor="{StaticResource CatMulti}"
                                    VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding DisplayText}"
                                   FontSize="15"
                                   LineBreakMode="TailTruncation"
                                   VerticalOptions="Center" />
                            <Button Grid.Column="2"
                                    Text="✕"
                                    Style="{StaticResource IconButton}"
                                    BackgroundColor="Transparent"
                                    BorderWidth="0"
                                    FontSize="14"
                                    TextColor="{StaticResource TextMuted}"
                                    SemanticProperties.Description="Remove step"
                                    Clicked="OnRemoveCommand"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Akcije -->
        <Border Grid.Row="3" Style="{StaticResource ActionBar}">
            <Grid ColumnDefinitions="*, 1.4*" ColumnSpacing="12">
                <Button x:Name="AddTaskBtn"
                        Text="+  Add step"
                        Style="{StaticResource SecondaryButton}"
                        HeightRequest="58"
                        Clicked="OnAddTaskClicked" />
                <Button Grid.Column="1"
                        x:Name="WriteBtn"
                        Text="Write to chip"
                        Style="{StaticResource PrimaryButton}"
                        Clicked="OnWriteClicked" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
