<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Gumby.Controls"
             x:Class="Gumby.MainPage"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContent}">

            <!-- Zaglavlje -->
            <Grid ColumnDefinitions="*, Auto" Margin="0,8,0,0">
                <VerticalStackLayout Spacing="6" VerticalOptions="Center">
                    <Label Text="GUMBY"
                           Style="{StaticResource Overline}"
                           TextColor="{StaticResource Accent}" />
                    <Label Text="What should your chip do?"
                           Style="{StaticResource Display}"
                           SemanticProperties.HeadingLevel="Level1" />
                </VerticalStackLayout>

                <Button Grid.Column="1"
                        Text="⚙"
                        Style="{StaticResource IconButton}"
                        VerticalOptions="Start"
                        SemanticProperties.Description="Settings"
                        Clicked="OnSettingsClicked" />
            </Grid>

            <Label Text="Pick an action, hold an NFC chip to your phone, and it runs every time you tap it."
                   Style="{StaticResource Body}"
                   Margin="0,10,0,0" />

            <!-- Istaknuto: više komandi -->
            <Border Background="{StaticResource HeroGradient}"
                    Stroke="{StaticResource StrokeStrong}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 26"
                    Padding="20"
                    Margin="0,24,0,0">
                <Grid RowDefinitions="Auto, Auto, Auto, Auto" ColumnDefinitions="*, Auto">
                    <Border Style="{StaticResource Pill}"
                            BackgroundColor="{StaticResource AccentSoft}">
                        <Label Text="ROUTINES"
                               Style="{StaticResource Overline}"
                               FontSize="11"
                               TextColor="{StaticResource Accent}" />
                    </Border>

                    <Label Grid.Column="1" Grid.RowSpan="2"
                           Text="🧩"
                           FontSize="40"
                           VerticalOptions="Start" />

                    <Label Grid.Row="1"
                           Text="One tap, many actions"
                           Style="{StaticResource Heading}"
                           FontSize="20"
                           Margin="0,14,0,0" />

                    <Label Grid.Row="2" Grid.ColumnSpan="2"
                           Text="Turn on WiFi, set the volume and open an app — all from a single chip."
                           Style="{StaticResource Caption}"
                           Margin="0,6,0,0" />

                    <Button Grid.Row="3" Grid.ColumnSpan="2"
                            x:Name="InsertMultiCommandBtn"
                            Text="Build a routine  →"
                            Style="{StaticResource PrimaryButton}"
                            HeightRequest="50"
                            Margin="0,18,0,0"
                            Clicked="OnInsertMultiCommandClicked" />
                </Grid>
            </Border>

            <!-- Akcije -->
            <Label Text="CREATE A TAG" Style="{StaticResource SectionTitle}" />

            <Grid ColumnDefinitions="*, *"
                  RowDefinitions="Auto, Auto, Auto"
                  ColumnSpacing="12"
                  RowSpacing="12">

                <c:ActionTile Grid.Row="0" Grid.Column="0"
                              Icon="🎵"
                              Title="Media"
                              Subtitle="YouTube and Spotify playlists"
                              AccentColor="{StaticResource CatMedia}"
                              Clicked="OnInsertPlaylistClicked" />

                <c:ActionTile Grid.Row="0" Grid.Column="1"
                              Icon="🔗"
                              Title="Links &amp; apps"
                              Subtitle="Websites, apps, Instagram and Maps"
                              AccentColor="{StaticResource CatLink}"
                              Clicked="OnInsertRefsClicked" />

                <c:ActionTile Grid.Row="1" Grid.Column="0"
                              Icon="📞"
                              Title="Phone"
                              Subtitle="Calls, messages and contacts"
                              AccentColor="{StaticResource CatPhone}"
                              Clicked="OnInsertPhoneClicked" />

                <c:ActionTile Grid.Row="1" Grid.Column="1"
                              Icon="⏰"
                              Title="Clock"
                              Subtitle="Alarms and timers"
                              AccentColor="{StaticResource CatClock}"
                              Clicked="OnInsertClockClicked" />

                <c:ActionTile Grid.Row="2" Grid.Column="0"
                              Icon="📶"
                              Title="Connectivity"
                              Subtitle="WiFi and Bluetooth"
                              AccentColor="{StaticResource CatConnect}"
                              Clicked="OnInsertConnectionClicked" />

                <c:ActionTile Grid.Row="2" Grid.Column="1"
                              Icon="🔊"
                              Title="Sound"
                              Subtitle="Volume, mute and vibrate"
                              AccentColor="{StaticResource CatSound}"
                              Clicked="OnVolumeClicked" />
            </Grid>

            <!-- Kako radi -->
            <Label Text="HOW IT WORKS" Style="{StaticResource SectionTitle}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="14">
                        <Border WidthRequest="30" HeightRequest="30"
                                StrokeShape="RoundRectangle 15"
                                BackgroundColor="{StaticResource AccentSoft}">
                            <Label Text="1" FontFamily="OpenSansSemibold" FontSize="13"
                                   TextColor="{StaticResource Accent}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="Choose what the chip should do"
                               Style="{StaticResource Caption}" VerticalOptions="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="14">
                        <Border WidthRequest="30" HeightRequest="30"
                                StrokeShape="RoundRectangle 15"
                                BackgroundColor="{StaticResource AccentSoft}">
                            <Label Text="2" FontFamily="OpenSansSemibold" FontSize="13"
                                   TextColor="{StaticResource Accent}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="Hold the chip to the back of your phone to write it"
                               Style="{StaticResource Caption}" VerticalOptions="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="14">
                        <Border WidthRequest="30" HeightRequest="30"
                                StrokeShape="RoundRectangle 15"
                                BackgroundColor="{StaticResource AccentSoft}">
                            <Label Text="3" FontFamily="OpenSansSemibold" FontSize="13"
                                   TextColor="{StaticResource Accent}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="Tap the chip any time — the action runs instantly"
                               Style="{StaticResource Caption}" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="Gumby NFC Commander · v1.0"
                   Style="{StaticResource Hint}"
                   HorizontalOptions="Center"
                   Margin="0,28,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
