<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Gumby.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0A0E17">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="0">

            <!-- Naslov -->
            <Label Text="Gumby"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   Margin="0,20,0,0"/>

            <Label Text="NFC Commander"
                   FontSize="14"
                   TextColor="#A0A8B8"
                   HorizontalOptions="Center"
                   Margin="0,0,0,20"/>

            <!-- Opis -->
            <Label Text="What would you like to create?"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"/>

            <Label Text="Tap any option to write to an NFC chip"
                   FontSize="13"
                   TextColor="#A0A8B8"
                   HorizontalOptions="Center"
                   Margin="0,5,0,25"/>

            <!-- Grid dugmadi 3 kolone -->
            <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto"
                  ColumnDefinitions="*, *, *"
                  RowSpacing="12"
                  ColumnSpacing="12">

                <!-- Red 1 -->
                <Button Grid.Row="0" Grid.Column="0"
                        x:Name="InsertPlaylistBtn"
                        Text="🎵 Playlist"
                        BackgroundColor="#1A2333"
                        TextColor="White"
                        CornerRadius="16"
                        HeightRequest="90"
                        FontSize="13"
                        Clicked="OnInsertPlaylistClicked"/>

                <Button Grid.Row="0" Grid.Column="1"
                        x:Name="InsertRefsBtn"
                        Text="🔗 Link / App"
                        BackgroundColor="#1A2333"
                        TextColor="White"
                        CornerRadius="16"
                        HeightRequest="90"
                        FontSize="13"
                        Clicked="OnInsertRefsClicked"/>

                <Button Grid.Row="0" Grid.Column="2"
                        x:Name="InsertPhoneBtn"
                        Text="📞 Phone"
                        BackgroundColor="#1A2333"
                        TextColor="White"
                        CornerRadius="16"
                        HeightRequest="90"
                        FontSize="13"
                        Clicked="OnInsertPhoneClicked"/>

                <!-- Red 2 -->
                <Button Grid.Row="1" Grid.Column="0"
                        x:Name="InsertClockBtn"
                        Text="⏰ Clock"
                        BackgroundColor="#1A2333"
                        TextColor="White"
                        CornerRadius="16"
                        HeightRequest="90"
                        FontSize="13"
                        Clicked="OnInsertClockClicked"/>

                <Button Grid.Row="1" Grid.Column="1"
                        x:Name="InsertConnectionBtn"
                        Text="🔌 Connect"
                        BackgroundColor="#1A2333"
                        TextColor="White"
                        CornerRadius="16"
                        HeightRequest="90"
                        FontSize="13"
                        Clicked="OnInsertConnectionClicked"/>

                <Button Grid.Row="1" Grid.Column="2"
                        x:Name="VolumeBtn"
                        Text="🔊 Sound"
                        BackgroundColor="#1A2333"
                        TextColor="White"
                        CornerRadius="16"
                        HeightRequest="90"
                        FontSize="13"
                        Clicked="OnVolumeClicked"/>

                <!-- Red 3 -->
                <Button Grid.Row="2" Grid.Column="0"
                        x:Name="InsertMultiCommandBtn"
                        Text="🧩 Multi Task"
                        BackgroundColor="#1A2333"
                        TextColor="White"
                        CornerRadius="16"
                        HeightRequest="90"
                        FontSize="13"
                        Clicked="OnInsertMultiCommandClicked"/>

                <!-- Red 4 - Settings dugme -->
                <Button Grid.Row="2" Grid.Column="1"
                        x:Name="SettingsBtn"
                        Text="⚙️ Settings"
                        BackgroundColor="#1A2333"
                        TextColor="White"
                        CornerRadius="16"
                        HeightRequest="90"
                        FontSize="13"
                        Clicked="OnSettingsClicked"/>

            </Grid>

            <!-- Footer -->
            <VerticalStackLayout Spacing="8" Margin="0,30,0,15">
                <BoxView HeightRequest="1" BackgroundColor="#2A3448"/>
                <Label Text="Gumby NFC Commander v1.0"
                       FontSize="11"
                       TextColor="#555555"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>