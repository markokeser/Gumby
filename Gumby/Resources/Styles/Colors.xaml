<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        Gumby dizajn sistem - tamna tema inspirisana logom (grafit + električno cijan).
        Iste vrednosti postoje i u Controls/AppColors.cs za upotrebu iz C# koda.
        Za Android pogledati i Platforms/Android/Resources/values/colors.xml
    -->

    <!-- Površine -->
    <Color x:Key="Background">#0A0D14</Color>
    <Color x:Key="Surface">#121722</Color>
    <Color x:Key="SurfaceRaised">#1A2130</Color>
    <Color x:Key="SurfaceInput">#0F141E</Color>
    <Color x:Key="Stroke">#232B3B</Color>
    <Color x:Key="StrokeStrong">#323D52</Color>

    <!-- Tekst -->
    <Color x:Key="TextPrimary">#F2F5FA</Color>
    <Color x:Key="TextSecondary">#97A1B4</Color>
    <Color x:Key="TextMuted">#5E687B</Color>
    <Color x:Key="TextOnAccent">#04131B</Color>

    <!-- Brend akcenat -->
    <Color x:Key="Accent">#2DD4E8</Color>
    <Color x:Key="AccentDeep">#3B82F6</Color>
    <Color x:Key="AccentSoft">#162F3A</Color>

    <!-- Stanja -->
    <Color x:Key="Success">#34D399</Color>
    <Color x:Key="Warning">#FBBF24</Color>
    <Color x:Key="Danger">#F87171</Color>
    <Color x:Key="DangerSoft">#2A1619</Color>

    <!-- Boje kategorija (ikonice i akcenti kartica) -->
    <Color x:Key="CatMedia">#A78BFA</Color>
    <Color x:Key="CatLink">#2DD4E8</Color>
    <Color x:Key="CatPhone">#34D399</Color>
    <Color x:Key="CatClock">#FBBF24</Color>
    <Color x:Key="CatConnect">#60A5FA</Color>
    <Color x:Key="CatSound">#F472B6</Color>
    <Color x:Key="CatMulti">#FB923C</Color>
    <Color x:Key="CatSettings">#94A3B8</Color>

    <!-- Brendovi -->
    <Color x:Key="BrandYouTube">#FF0033</Color>
    <Color x:Key="BrandSpotify">#1ED760</Color>
    <Color x:Key="BrandInstagram">#E1306C</Color>
    <Color x:Key="BrandMaps">#34A853</Color>

    <!-- Četkice -->
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2DD4E8" Offset="0.0" />
        <GradientStop Color="#3B82F6" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#123044" Offset="0.0" />
        <GradientStop Color="#141B33" Offset="0.6" />
        <GradientStop Color="#1B1533" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Zadržano zbog kompatibilnosti sa šablonom -->
    <Color x:Key="Primary">#2DD4E8</Color>
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
</ResourceDictionary>
